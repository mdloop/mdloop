# Copy to .env for a self-hosted mdloop instance (packages/api/src/selfhost-main.ts).
# Never commit real values. See .env.example for the multi-tenant entrypoint's
# full variable set (DB pool tuning, OTel, MCP OAuth, ...) — every var documented
# there still applies here unless overridden below; this file covers only what's
# specific to self-hosting.

# Must connect as the mdloop_login role (migration 0024) — non-superuser,
# NOBYPASSRLS, member of mdloop_app/mdloop_provisioner/mdloop_public_reader.
# selfhost-main.ts asserts this at startup and refuses to serve otherwise
# (RLS tenant isolation, CONSTITUTION §4), even though a self-host instance
# has only one tenant. mdloop_login ships with NO password (migration 0024's
# own comment: local dev uses the trust socket; prod credentials are a
# deployment/secrets concern, not something this codebase sets for you).
# Pick ONE before setting DATABASE_URL below:
#   (a) running Postgres via Docker Compose / a managed host: set APP_LOGIN_PASSWORD
#       below and put the same value in the connection string here — the
#       migration one-shot (step 1, migrate-main.js) then runs `ALTER ROLE
#       mdloop_login WITH PASSWORD '...'` for you, idempotently, on every
#       deploy, so this never drifts from what's actually in the database.
#   (b) Postgres on the same host as this process: leave mdloop_login
#       passwordless and use peer/trust auth in pg_hba.conf instead, then
#       omit the password from the connection string and leave
#       APP_LOGIN_PASSWORD unset.
DATABASE_URL=postgres://mdloop_login:CHANGE_ME@localhost:5432/mdloop

# Only used by the migration one-shot (migrate-main.js) — see option (a)
# above. Never read by selfhost-main.ts itself; the actual runtime connection
# password lives in DATABASE_URL. Leave unset for option (b).
APP_LOGIN_PASSWORD=

SESSION_SECRET=change-me-to-a-random-32-plus-char-string
API_BASE_URL=http://localhost:3000
WEB_APP_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3000
PORT=3000
NODE_ENV=production

# single-user (default if unset) — one fixed admin identity, no login screen,
# configured below. oidc — real browser login against any OIDC provider
# (Keycloak, Authentik, Dex, Google, Okta, ...) via discovery.
MDLOOP_AUTH_MODE=single-user

# single-user mode only. Defaults to admin@localhost / Admin if unset.
MDLOOP_ADMIN_EMAIL=admin@localhost
MDLOOP_ADMIN_NAME=Admin

# oidc mode only — all three required together; selfhost-main.ts refuses to
# boot with MDLOOP_AUTH_MODE=oidc and any of these missing rather than
# silently falling back to single-user.
OIDC_ISSUER=
OIDC_CLIENT_ID=
# Omit for a public client authenticating via PKCE alone.
OIDC_CLIENT_SECRET=

# Serve the built web SPA (packages/web/dist) directly from this process —
# the default for a single-process self-host deploy with nowhere else to put
# it. Set to "false" if you're fronting mdloop with your own reverse proxy
# or static host serving the SPA separately.
MDLOOP_SERVE_WEB=true

# Blob storage: unset MDLOOP_BLOBS_BUCKET uses the local filesystem
# (BLOB_STORAGE_DIR below). Refused under NODE_ENV=production unless
# MDLOOP_ALLOW_LOCAL_BLOB_STORAGE=true is also set (see storageFromEnv) — the
# refusal exists for container deployments with an ephemeral/read-only root
# filesystem, which a real self-hosted instance with a persistent volume is
# not, so this line is what actually lets NODE_ENV=production (needed above
# for secure cookies) coexist with local-disk storage. Set MDLOOP_BLOBS_BUCKET
# instead to use S3 or an S3-compatible backend (MinIO, R2, Backblaze B2);
# MDLOOP_BLOBS_ENDPOINT/MDLOOP_BLOBS_FORCE_PATH_STYLE are only needed for the
# latter (MinIO, R2 — see packages/persistence/src/storage/s3-storage.ts).
MDLOOP_ALLOW_LOCAL_BLOB_STORAGE=true
BLOB_STORAGE_DIR=.mdloop-blobs
MDLOOP_BLOBS_BUCKET=
MDLOOP_BLOBS_ENDPOINT=
MDLOOP_BLOBS_FORCE_PATH_STYLE=
AWS_REGION=us-east-1

# SMTP (SmtpEmailAdapter, packages/api/src/email/smtp-email.adapter.ts).
# Unset SMTP_HOST -> emails are logged, not sent (invite/share tokens still
# come back in the API response either way — email is never load-bearing).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=mdloop@localhost
