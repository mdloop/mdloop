{
  "name": "vorlyn",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.0.1",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --build && chmod +x packages/cli/dist/main.js",
    "build": "pnpm typecheck && pnpm --filter @vorlyn/web build",
    "build:package": "node scripts/release/build-dist.mjs",
    "check-external-deps": "node scripts/release/check-external-deps.mjs",
    "smoke:package": "node scripts/release/smoke-install.mjs",
    "smoke:plugin-loop": "node scripts/release/smoke-published-plugin.mjs",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "boundaries": "depcruise packages --config .dependency-cruiser.cjs",
    "test:e2e": "playwright test",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm boundaries && pnpm audit --audit-level=high --ignore-unfixable && pnpm test && pnpm brand-check && pnpm docs:check",
    "verify:release": "pnpm verify && pnpm build && pnpm build:package && pnpm check-external-deps && pnpm smoke:package",
    "build:gen-docs": "tsc --build scripts/gen-docs",
    "gen:mcp": "pnpm build:gen-docs && node scripts/gen-docs/dist/mcp.js",
    "gen:cli": "pnpm build:gen-docs && node scripts/gen-docs/dist/cli.js",
    "gen:docs": "pnpm build:gen-docs && node scripts/gen-docs/dist/generate-all.js",
    "docs:check": "pnpm build:gen-docs && node scripts/gen-docs/dist/check-drift.js",
    "brand-check": "node scripts/dev/check-rename-consistency.mjs",
    "rename": "node scripts/dev/rename.mjs"
  },
  "devDependencies": {
    "@amiceli/vitest-cucumber": "^7.0.0",
    "@eslint/js": "^9.30.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^3.2.7",
    "@vorlyn/api": "workspace:*",
    "@vorlyn/app": "workspace:*",
    "@vorlyn/mcp": "workspace:*",
    "@vorlyn/persistence": "workspace:*",
    "dependency-cruiser": "^16.10.0",
    "esbuild": "0.28.2",
    "eslint": "^9.30.0",
    "eslint-config-prettier": "^10.1.0",
    "fastify": "^5.4.0",
    "prettier": "^3.6.0",
    "ts-morph": "^28.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.0"
  },
  "pnpm": {
    "overrides": {
      "fast-uri@3": "3.1.4",
      "fast-uri@4": "4.1.1",
      "find-my-way": ">=9.7.0",
      "postcss": ">=8.5.18",
      "brace-expansion@5": "5.0.8"
    },
    "auditConfig": {}
  }
}
