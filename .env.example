# Copy to .env for local development against a real Postgres (`make dev`).
# Never commit real values. For a real always-on self-hosted instance, see
# .env.selfhost.example and SELF_HOSTING.md instead — this file is the local
# dev shape (loopback auth via dev-main.ts, not the customer-facing entrypoint).
#
# PROD: this MUST connect as the vorlyn_login role (migration 0024) —
# non-superuser, NOBYPASSRLS, member of vorlyn_app/vorlyn_provisioner/
# vorlyn_public_reader. The api/mcp/jobs entrypoints assert the connected role is
# not a superuser/BYPASSRLS role at startup and refuse to serve otherwise, so
# RLS tenant isolation (CONSTITUTION §4) can never be silently defeated. LOCAL
# DEV uses the trust socket as your OS superuser via dev-main.ts, which is a
# separate, non-prod entrypoint and does not run that assertion.
DATABASE_URL=postgres://localhost:5432/vorlyn
# Path to a PEM CA bundle, for TLS to a real Postgres that requires
# verify-full. Unset locally (the trust socket never speaks TLS). A
# set-but-unreadable path throws at boot rather than silently connecting
# without TLS; verification (CA chain + hostname) is never disabled.
DB_SSL_CA_PATH=
SESSION_SECRET=change-me-to-a-random-32-plus-char-string
# In-flight SESSION_SECRET rotation only; normally unset. Session + CSRF
# tokens signed with this value still verify, never used to sign new ones.
# Rotation: set this to the outgoing SESSION_SECRET, roll SESSION_SECRET to
# the new value, redeploy — old sessions keep working until they expire or
# are silently refreshed. Drop this var in a later deploy once rotation is
# complete.
SESSION_SECRET_PREVIOUS=
API_BASE_URL=http://localhost:3000
# Also read by mcp/main.ts (same value — a separate process, so it can't
# read api's config directly): when set, upload_document/request_review
# include a `url` straight to the document instead of leaving the reviewer
# to go find it. Omitted from tool responses, not guessed, when unset.
WEB_APP_URL=http://localhost:5173
# api/main.ts HTTP port (defaults to 3000 if unset); mcp/main.ts's own port:
PORT=3000
MCP_PORT=3001
# development | production | test — gates secureCookies and dev-main.ts's
# refusal to run with NODE_ENV=production. Leave unset for local dev.
NODE_ENV=development
# CSRF Origin allowlist: the single browser origin the SPA is served
# from. A mutating request whose Origin header is present must match this exactly.
WEB_ORIGIN=http://localhost:5173
# From the WorkOS dashboard (test environment). Optional — a deployment can
# run VORLYN_AUTH_MODE=single-user or =oidc instead (see SELF_HOSTING.md).
WORKOS_API_KEY=sk_test_...
WORKOS_CLIENT_ID=client_...
# MCP OAuth (ADR 0013, mcp/main.ts only): WorkOS AuthKit as the whole
# authorization server, packages/mcp as a protected resource (RFC 9728).
# All three below are optional as a group — unset means MCP OAuth is simply
# off and only the vorlyn_-prefixed API-key path works. Once set, all three
# are required together (packages/mcp/src/env-config.ts throws loud at boot
# on a partial group).
# WORKOS_AUTHKIT_ISSUER: the AuthKit `iss` claim to require, from the WorkOS
# dashboard's Resource Indicator config for this client.
WORKOS_AUTHKIT_ISSUER=
# MCP_RESOURCE_INDICATOR: this MCP server's own public URL — must exactly
# match the Resource Indicator registered on the WorkOS dashboard. For local
# testing against a real AuthKit environment, point it at your local MCP
# endpoint (e.g. http://localhost:3001).
MCP_RESOURCE_INDICATOR=
# WORKOS_JWKS_URL: optional even once the other two are set — defaults to
# ${WORKOS_AUTHKIT_ISSUER}/oauth2/jwks (env-config.ts). Note: this is NOT the
# same JWKS as WorkOS's getJwksUrl(clientId) SDK helper (which verifies
# session tokens, not the OAuth/Connect access tokens this path validates).
WORKOS_JWKS_URL=
# Local blob storage root (filesystem adapter). See storageFromEnv
# (packages/persistence) for the S3/S3-compatible alternative below.
BLOB_STORAGE_DIR=.vorlyn-blobs
# Set to select S3Storage over FsStorage — see storageFromEnv
# (packages/persistence). storageFromEnv refuses to boot under
# NODE_ENV=production if this is unset and VORLYN_ALLOW_LOCAL_BLOB_STORAGE
# isn't set either, rather than failing on the first upload. Leave unset
# locally.
VORLYN_BLOBS_BUCKET=
# Public Docs Hub (ADR 0004): org id allowed to publish to the public,
# unauthenticated hub. Unset disables publishing entirely.
PUBLIC_HUB_ORG_ID=
# pg.Pool tuning for both prod entrypoints (api/main.ts, mcp/main.ts) — sane
# defaults if unset:
DB_POOL_MAX=10
DB_POOL_CONNECTION_TIMEOUT_MS=5000
DB_POOL_IDLE_TIMEOUT_MS=30000
# Per-transaction statement_timeout (withTenant/withProvisioner/withPublicReader):
DB_STATEMENT_TIMEOUT_MS=30000
# Compliance scheduler sweep interval (jobs/main.ts); defaults to 1h if unset:
JOB_INTERVAL_MS=3600000
# Vendor-neutral OTel bootstrap (packages/persistence/src/telemetry/setup.ts):
# unset uses the console exporter (local dev); set to an OTel collector URL
# in staging/prod for OTLP export.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Standard OTel var, read natively by the SDK (verified against the installed
# @opentelemetry/sdk-node version — `OTEL_SDK_DISABLED=true` makes every
# span/metric call a true no-op, never registering exporters at all).
# Validated here only so a typo (e.g. "True", "1") fails loud at boot instead
# of silently NOT disabling anything, which is the SDK's own permissive
# default for a garbage value. Set to "true" wherever no OTel collector is
# reachable — otherwise a process with OTEL_EXPORTER_OTLP_ENDPOINT unset
# falls back to the console exporter and ships every span/metric to whatever
# your process's stdout lands in.
OTEL_SDK_DISABLED=
# Local dev database name (dev-main.ts creates it if missing); ignored by
# every prod entrypoint, which requires DATABASE_URL instead:
DEV_DB_NAME=vorlyn_dev
# Local-agent stdio MCP entrypoint (packages/mcp/src/stdio-main.ts) and the
# sync CLI (packages/cli) — an API key scoped to one user, and the MCP
# endpoint `vorlyn link` targets by default:
VORLYN_API_KEY=
VORLYN_MCP_URL=http://localhost:3001/mcp
# Shared-store rate limiter (api/main.ts, mcp/main.ts — ADR 0010):
# Redis/Valkey connection string. Unset falls back to the in-process
# UserRateLimiter (safe single-node/dev default, correct behavior for local
# dev); a malformed value fails loud at boot rather than silently degrading.
REDIS_URL=
