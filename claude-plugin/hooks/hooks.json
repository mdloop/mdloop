{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/mdloop-ensure.sh\"",
            "shell": "bash",
            "async": true,
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/mdloop-sync.sh\"",
            "shell": "bash",
            "async": true,
            "timeout": 60
          }
        ]
      }
    ]
  }
}
